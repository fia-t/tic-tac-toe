rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Адмін визначається виключно custom claim'ом admin: true у ID token,
    // а не способом входу чи поштою. Claim можна встановити лише через
    // Firebase Admin SDK (scripts/setAdminClaim.js) - жоден клієнт чи
    // публічна Cloud Function не мають до цього доступу.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /themes/{themeId} {
      // Каталог фонів/скінів публічний на читання - його підвантажує будь-який
      // гравець (навіть до анонімного входу) ще до старту гри.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /campaignChapters/{chapterId} {
      // Розділи й рівні кампанії - публічні на читання (гра підвантажує їх до входу),
      // редагуються лише з адмінки (розділ "Кампанія").
      allow read: if true;
      allow write: if isAdmin();
    }

    match /modifierSettings/{modifierId} {
      // Налаштування модифікаторів з адмінки (розділ "Модифікатори") - які пропонуються
      // в редакторі кампанії. Читати може будь-хто, як і кампанію; пише лише адмін.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /translations/{locale} {
      // Правки перекладів з адмінки (розділ "Переклади") поверх вбудованих текстів гри -
      // гра читає документ своєї мови ще до входу; пише лише адмін.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /names/{nameId} {
      // Пул "цікавих" імен для рахунку над полем гри - так само публічний на
      // читання, як і теми, і так само редагується лише з адмінки.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gameLogs/{logId} {
      // Запис лічильника зіграних партій дозволений будь-кому (навіть без
      // автентифікації - vs-AI режим повністю офлайн і не має анонімного
      // входу), але лише документ строго очікуваної форми. Читає/перелічує
      // лише адмінка (дашборд), звичайний гравець власні логи не бачить.
      allow create: if isValidGameLog(request.resource.data);
      allow read, list: if isAdmin();
      allow update, delete: if false;
    }

    match /gameBuilds/{buildId} {
      // Історія білдів гри для порталу (адмінка -> "Білд гри"). Адмін створює
      // заявку в статусі queued, далі статус/посилання на ZIP пише GitHub Actions
      // через Admin SDK (в обхід rules). update дозволений адміну лише щоб
      // позначити failed, якщо workflow так і не вдалося запустити.
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.status == "queued";
      allow update: if isAdmin() && request.resource.data.status == "failed";
      allow delete: if false;
    }

    match /matchQueue/{uid} {
      // Черга швидкого матчу: пише лише сервер (Admin SDK), гравець бачить лише свій запис -
      // щоб дізнатися, що суперника знайдено.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /presence/{uid} {
      // Хто зараз у грі й хто шукає суперника (лічильник "онлайн" і запрошення зіграти).
      // Читати (і рахувати) може будь-який гравець з анонімним входом; писати - лише свій
      // документ і лише очікуваної форми.
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid && isValidPresence(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    function isValidPresence(data) {
      return data.keys().hasOnly(['lastSeen', 'expiresAt', 'screen', 'searching', 'name'])
        && data.lastSeen == request.time
        && data.expiresAt is timestamp
        && data.screen in ['menu', 'game']
        && data.searching is bool
        && data.name is string && data.name.size() <= 40;
    }

    match /players/{uid} {
      // Картка гравця для адмінки (розділ "Гравці"): пише лише сам гравець свій документ
      // очікуваної форми, читає - він сам і адмін (список - лише адмін).
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid && isValidPlayer(request.resource.data);
      allow delete: if isAdmin();
    }

    function isValidPlayer(data) {
      return data.keys().hasOnly(['name', 'qsId', 'source', 'hosts', 'firstSeen', 'lastPlayed', 'games', 'wins', 'draws',
          'losses', 'onlineWins', 'level', 'xp', 'coins', 'campaignStars', 'dailyStreak', 'rating', 'ratedPlayed'])
        && data.name is string && data.name.size() <= 60
        && (data.qsId == null || (data.qsId is string && data.qsId.size() <= 80))
        && data.source in ['site', 'portal', 'crazygames', 'poki', 'itch']
        && data.hosts is list && data.hosts.size() <= 30
        && data.lastPlayed == request.time
        && data.games is int && data.wins is int && data.draws is int && data.losses is int
        && data.level is int && data.xp is int && data.coins is int && data.campaignStars is int
        && data.dailyStreak is int && data.rating is number && data.ratedPlayed is bool;
    }

    match /ratings/{playerId} {
      // Рейтинг і лідерборд: читає будь-хто, пише лише сервер після рейтингового матчу.
      allow read: if true;
      allow write: if false;
    }

    match /rooms/{roomId} {

      // Читати кімнату може будь-хто автентифікований (анонімна авторизація теж
      // рахується) - потрібно, щоб гравець, який щойно перейшов за посиланням,
      // міг перевірити її статус ще до приєднання.
      allow get: if request.auth != null;

      // Перелік/пошук усіх кімнат заборонений - доступ лише за відомим roomId
      // (з посилання-запрошення), щоб чужі кімнати не можна було перебрати.
      allow list: if false;

      allow create: if request.auth != null && isValidNewRoom(request.resource.data);

      // Рейтингова кімната (швидкий матч): ходи й результат пише лише сервер (/api/match/move) -
      // клієнт може оновити тільки свою присутність (heartbeat, "покинув гру"), не змінюючи гравців.
      allow update: if request.auth != null && (
        resource.data.get('rated', false) == true
          ? isExistingPlayer(resource.data, request.auth.uid) && isPresenceOnlyUpdate(resource.data, request.resource.data)
          : (isExistingPlayer(resource.data, request.auth.uid) || isJoiningOpenSlot(resource.data, request.resource.data))
      );

      allow delete: if false; // прибирання застарілих кімнат - через Firestore TTL, не з клієнта
    }
  }

  function isValidGameLog(data) {
    return data.mode in ['ai-easy', 'ai-hard', 'ai-5x5', 'friend-3x3', 'friend-9x9', 'friend-5x5']
      && data.outcome in ['win', 'lose', 'draw', 'x_win', 'o_win']
      // source необов'язкове - вже викладені на порталах старі білди його не шлють.
      && (!('source' in data) || data.source in ['site', 'portal', 'crazygames', 'poki', 'itch'])
      && data.createdAt == request.time;
  }

  function isValidNewRoom(data) {
    return data.gameMode in ['3x3', '9x9', '5x5']
      && data.status == 'waiting'
      && data.winner == null
      && data.players.X.uid == request.auth.uid
      && !('O' in data.players);
  }

  function isPresenceOnlyUpdate(before, after) {
    return after.diff(before).affectedKeys().hasOnly(['players', 'leftPlayer', 'lastActivity', 'expiresAt'])
      && after.players.X.uid == before.players.X.uid
      && after.players.O.uid == before.players.O.uid;
  }

  function isExistingPlayer(data, uid) {
    return (('X' in data.players) && data.players.X.uid == uid)
      || (('O' in data.players) && data.players.O.uid == uid);
  }

  // Дозволяє записати себе в кімнату лише на дійсно вільне місце O
  // (X уже зайнятий кимось іншим, O ще нікому не належить).
  function isJoiningOpenSlot(before, after) {
    return ('X' in before.players) && !('O' in before.players)
      && ('O' in after.players) && after.players.O.uid == request.auth.uid;
  }
}
